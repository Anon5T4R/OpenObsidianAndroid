<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base app theme — applied after the splash screen exits.
      Transparent bars so Compose edge-to-edge insets take full control.
    -->
    <style name="Theme.OpenObsidian.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Splash screen theme (androidx.core:core-splashscreen).
      - Background: brand violet
      - Animated icon: white hexagon foreground
      - After splash: switches to the base theme
    -->
    <style name="Theme.OpenObsidian.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#7C3AED</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenObsidian.Base</item>
    </style>
</resources>
